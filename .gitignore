# Godot 4+ specific ignores
.godot/
/android/
/ios/

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# System
.DS_Store
Thumbs.db

# VS Code
.vscode/

# Visual Studio
.vs/

# Rider
.idea/

# User-specific files
*.user
*.suo

# Build results
bin/
obj/
[Dd]ebug/
[Rr]elease/
build/
publish/

# User saves and logs
saves/
logs/
*.log

# Runtime game data (news, history files)
SCORES/

# Generated wiki export (built again from game code for each release)
/wiki-data/
/web/wiki/
/web/node_modules/

# Exported game builds
*.exe
*.pck
*.zip
*.dmg
*.app/

# Exclude publish artifacts
**/publish/
**/build/

# Claude Code context file
CLAUDE.md

# Claude Code local data
.claude/

# Codex local agent configs
.codex/

# Telemetry config (contains webhook URLs - never commit)
telemetry_config.txt
nul

# Server env files (contain webhook URLs - never commit)
# The .example sibling IS committed as a template.
*.env
!*.env.example

# Dev/localization tooling scripts (not part of the game); tools/promptfoo is committed (its own
# .gitignore drops node_modules and results)
tools/*
!tools/promptfoo/
!tools/wiki-build/
DOCS/FEEDBACK_PLAN_0.56.0.md
AGENTS.md
__pycache__/
supervision_log.md
