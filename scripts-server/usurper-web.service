# Usurper Reborn - Web Terminal Proxy Service
# Runs the WebSocket-to-SSH bridge for browser-based play
#
# Install:
#   sudo cp usurper-web.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable usurper-web
#   sudo systemctl start usurper-web
#
# Monitor:
#   sudo systemctl status usurper-web
#   sudo journalctl -u usurper-web -f

[Unit]
Description=Usurper Reborn Web Terminal Proxy
After=network.target

[Service]
Type=simple
User=usurper
WorkingDirectory=/opt/usurper/web
EnvironmentFile=-/opt/usurper/web/.env
ExecStart=/usr/bin/node ssh-proxy.js
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Resource limits
LimitNOFILE=1024
# v1.1.8: 128M starved this process. Answering /api/stats pulls tens of megabytes of player
# JSON through SQLite and V8, and under the old ceiling the kernel kept evicting the pages it
# was about to reread: across one 280-request measurement the cgroup hit its limit 10,964
# times and took 9,408 major faults. At 384M the same run hits the limit zero times and takes
# 4,024, and the service holds 144 MB of file cache where it held 29 MB.
# This was a real fault but not the cause of the site being slow; that was unindexed JSON
# reads, fixed in the schema. Raising the ceiling alone moved the worst stall from 83.3 s to
# 77.2 s. The box has 1.9 GB and the game server sits at about 200 MB of its own 960 MB cap.
MemoryMax=384M

[Install]
WantedBy=multi-user.target
