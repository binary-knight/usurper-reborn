# Usurper Reborn - Web Terminal Proxy Service
# Runs the WebSocket-to-SSH bridge for browser-based play
#
# Install:
#   sudo cp usurper-web.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable usurper-web
#   sudo systemctl start usurper-web
#
# Monitor:
#   sudo systemctl status usurper-web
#   sudo journalctl -u usurper-web -f

[Unit]
Description=Usurper Reborn Web Terminal Proxy
After=network.target

[Service]
Type=simple
User=usurper
WorkingDirectory=/opt/usurper/web
EnvironmentFile=-/opt/usurper/web/.env
ExecStart=/usr/bin/node ssh-proxy.js
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Resource limits
LimitNOFILE=1024
# v1.1.8: 128M starved this process. Answering /api/stats pulls about 33 MB of player
# JSON through SQLite and V8; under the old ceiling the kernel evicted the pages it was
# about to reread, so one cold call reclaimed roughly 478 MB, took about 2,000 major
# faults and hit the ceiling 1,948 times, turning a 0.2 second query into 20 seconds.
# The box has 1.9 GB and the game server sits at about 200 MB of its own 960 MB cap.
MemoryMax=384M

[Install]
WantedBy=multi-user.target
