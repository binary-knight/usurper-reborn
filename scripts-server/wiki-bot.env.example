# Append to the existing web service environment; never commit real IDs or tokens.
# The existing DISCORD_BOT_TOKEN and Message Content intent are required.
# Wiki-only operation does not require a gossip channel.
DISCORD_WIKI_CHANNEL_IDS=
# One or more comma-separated role IDs allowed to Suggest; empty disables Suggest.
DISCORD_WIKI_HELPER_ROLE_ID=
WIKI_SITE_ORIGIN=https://usurper-reborn.net
# Optional Ask with the Claude API (see DOCS/WIKI_OPERATIONS.md). Off unless DISCORD_WIKI_LLM=on.
# Put the key only in the root-owned usurper-web systemd drop-in.
DISCORD_WIKI_LLM=
ANTHROPIC_API_KEY=
DISCORD_WIKI_LLM_DAILY_TOKENS=
DISCORD_WIKI_LLM_USER_DAILY=
